        self.cap = None
        self.current_barcode = ""
        self.current_product = None
        
        # تهيئة قاعدة البيانات
        self.init_database()
        
        # بناء الواجهة
        self.setup_ui()
        
        # بدء الكاميرا
        self.start_camera()
        
        # تحديث الإحصائيات
        self.update_stats()
    
    def init_database(self):
        """إنشاء قاعدة البيانات وجداولها"""
        self.conn = sqlite3.connect('inventory.db')
        self.cursor = self.conn.cursor()
        
        # جدول الأصناف
        self.cursor.execute('''
            CREATE TABLE IF NOT EXISTS products (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                barcode TEXT UNIQUE NOT NULL,
                name TEXT NOT NULL,
                category TEXT,
                price REAL,
                quantity INTEGER DEFAULT 0,
                created_date TEXT,
                last_updated TEXT
            )
        ''')
        
        # جدول سجل الجرد
        self.cursor.execute('''
            CREATE TABLE IF NOT EXISTS audit_log (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                barcode TEXT NOT NULL,
                product_name TEXT,
                audit_date TEXT,
                auditor_name TEXT,
                status TEXT
            )
        ''')
        
        # جدول الإعدادات
        self.cursor.execute('''
            CREATE TABLE IF NOT EXISTS settings (
                key TEXT PRIMARY KEY,
                value TEXT
            )
        ''')
        
        # إضافة بعض البيانات التجريبية إذا كانت قاعدة البيانات فارغة
        self.cursor.execute("SELECT COUNT(*) FROM products")
        if self.cursor.fetchone()[0] == 0:
            self.add_sample_data()
        
        self.conn.commit()
    
    def add_sample_data(self):
        """إضافة بيانات تجريبية للاختبار"""
        sample_products = [
            ("123456789012", "شاشة 24 بوصة LED", "إلكترونيات", 450.00, 10),
            ("987654321098", "ماوس لاسلكي", "إلكترونيات", 25.00, 50),
            ("555555555555", "لوحة مفاتيح", "إلكترونيات", 35.00, 30),
            ("111111111111", "طابعة ليزر", "مكتبية", 250.00, 5),
            ("222222222222", "ورق A4", "مكتبية", 12.50, 100),
        ]
        
        now = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        for barcode, name, category, price, qty in sample_products:
            self.cursor.execute('''
                INSERT INTO products (barcode, name, category, price, quantity, created_date, last_updated)
                VALUES (?, ?, ?, ?, ?, ?, ?)
            ''', (barcode, name, category, price, qty, now, now))
        
        self.conn.commit()
    
