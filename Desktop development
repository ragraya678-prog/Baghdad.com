import tkinter as tk
from tkinter import messagebox

def show_message():
    name = entry.get()
    messagebox.showinfo("مرحباً", f"أهلاً {name}")

app = tk.Tk()
app.title("تطبيقي الأول")
app.geometry("400x200")

label = tk.Label(app, text="اكتب اسمك:")
label.pack(pady=10)

entry = tk.Entry(app)
entry.pack(pady=10)

button = tk.Button(app, text="اضغط هنا", command=show_message)
button.pack(pady=10)

app.mainloop()
