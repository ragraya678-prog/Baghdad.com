import random
import sys

def game():
    print("=" * 30)
    print("🎲  لعبة خمن الرقم  🎲")
    print("=" * 30)
    print("الأرقام من 1 إلى 20")
    print("لديك 5 محاولات فقط!\n")
    
    # الرقم السري العشوائي
    secret_number = random.randint(1, 20)
    attempts = 5
    
    # قائمة لتخزين تخمينات المستخدم
    guesses = []
    
    while attempts > 0:
        print(f"💡 لديك {attempts} محاولات متبقية")
        
        # التأكد من أن الإدخال رقم صحيح
        try:
            guess = int(input("أدخل تخمينك: "))
        except ValueError:
            print("❌ خطأ: الرجاء إدخال رقم صحيح!")
            continue
        
        # إضافة التخمين للقائمة
        guesses.append(guess)
        
        # مقارنة التخمين بالرقم السري
        if guess < 1 or guess > 20:
            print("⚠️  الرجاء إدخال رقم بين 1 و 20 فقط!")
            continue
            
        if guess == secret_number:
            print("\n🎉 🎉 🎉  مبروك! لقد فزت!  🎉 🎉 🎉")
            print(f"✅ الرقم كان {secret_number} ✅")
            print(f"📊 عدد محاولاتك: {len(guesses)}")
            print(f"🔢 تخميناتك: {guesses}")
            break
        elif guess < secret_number:
            print("📈 الرقم السري أعلى من تخمينك 📈")
        else:
            print("📉 الرقم السري أقل من تخمينك 📉")
        
        attempts -= 1
        
        # إضافة سطر فاصل
        print("-" * 30)
    
    # إذا انتهت المحاولات دون فوز
    if attempts == 0 and guess != secret_number:
        print("\n💀 💀 💀  لقد خسرت!  💀 💀 💀")
        print(f"🔢 الرقم السري كان: {secret_number}")
        print(f"🔢 تخميناتك: {guesses}")
    
    # سؤال اللاعب إذا كان يريد اللعب مرة أخرى
    print("\n" + "=" * 30)
    play_again = input("هل تريد اللعب مرة أخرى؟ (نعم/لا): ").strip().lower()
    if play_again in ['نعم', 'yes', 'y', 'ن']:
        print("\n" * 2)
        game()
    else:
        print("👋 شكراً للعب! إلى اللقاء 👋")
        sys.exit()

# بدء اللعبة
if __name__ == "__main__":
    game()
